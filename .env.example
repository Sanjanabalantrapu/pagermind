# --- Memory: Hindsight -------------------------------------------------------
# Local server (docker compose up) or Hindsight Cloud (https://ui.hindsight.vectorize.io)
MEMORY_BACKEND=hindsight
HINDSIGHT_URL=http://localhost:8888
# HINDSIGHT_API_KEY=hs-...            # required for Hindsight Cloud
PAGERMIND_TEAM=shopfast-sre            # bank id becomes pagermind-<team>

# --- LLM: any OpenAI-compatible endpoint (Groq default) ----------------------
GROQ_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
